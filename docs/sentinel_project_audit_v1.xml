<?xml version="1.0" encoding="UTF-8"?>
<h:html xmlns="http://www.w3.org/2002/xforms"
  xmlns:h="http://www.w3.org/1999/xhtml"
  xmlns:orx="http://openrosa.org/xforms"
  xmlns:jr="http://openrosa.org/javarosa">
  <h:head>
    <h:title>Sentinel Project Audit v1</h:title>
    <model>
      <instance>
        <data id="sentinel_project_audit" version="1">
          <record_type/>
          <project_id/>
          <source_form_id/>
          <source_instance_id/>
          <source_version_id/>
          <source_audit_instance_id/>
          <source_content_sha256/>
          <collect_audit_sha256/>
          <central_created_at/>
          <central_actor_id/>
          <change_reason/>
          <reason_link_status/>
          <timestamp_status/>
          <timestamp_time/>
          <sentinel_run_id/>
          <checkpoint_cursor/>
          <source_bundle/>
          <meta><instanceID/></meta>
        </data>
      </instance>
      <bind nodeset="/data/record_type" type="string" required="true()"/>
      <bind nodeset="/data/project_id" type="string" required="true()"/>
      <bind nodeset="/data/source_form_id" type="string"/>
      <bind nodeset="/data/source_instance_id" type="string"/>
      <bind nodeset="/data/source_version_id" type="string"/>
      <bind nodeset="/data/source_audit_instance_id" type="string"/>
      <bind nodeset="/data/source_content_sha256" type="string"/>
      <bind nodeset="/data/collect_audit_sha256" type="string"/>
      <bind nodeset="/data/central_created_at" type="string"/>
      <bind nodeset="/data/central_actor_id" type="string"/>
      <bind nodeset="/data/change_reason" type="string"/>
      <bind nodeset="/data/reason_link_status" type="string"/>
      <bind nodeset="/data/timestamp_status" type="string"/>
      <bind nodeset="/data/timestamp_time" type="string"/>
      <bind nodeset="/data/sentinel_run_id" type="string"/>
      <bind nodeset="/data/checkpoint_cursor" type="string"/>
      <bind nodeset="/data/source_bundle" type="binary"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()"
        calculate="concat('uuid:', uuid())" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/record_type"><label>Record type</label></input>
    <input ref="/data/project_id"><label>Project ID</label></input>
    <input ref="/data/source_form_id"><label>Source form ID</label></input>
    <input ref="/data/source_instance_id"><label>Source instance ID</label></input>
    <input ref="/data/source_version_id"><label>Source version ID</label></input>
    <input ref="/data/source_audit_instance_id"><label>Deterministic audit ID</label></input>
    <input ref="/data/source_content_sha256"><label>Source content SHA-256</label></input>
    <input ref="/data/collect_audit_sha256"><label>Collect audit SHA-256</label></input>
    <input ref="/data/central_created_at"><label>Central created at</label></input>
    <input ref="/data/central_actor_id"><label>Central actor</label></input>
    <input ref="/data/change_reason"><label>Linked change reason</label></input>
    <input ref="/data/reason_link_status"><label>Reason link status</label></input>
    <input ref="/data/timestamp_status"><label>Timestamp status</label></input>
    <input ref="/data/timestamp_time"><label>Timestamp time</label></input>
    <input ref="/data/sentinel_run_id"><label>Sentinel run ID</label></input>
    <input ref="/data/checkpoint_cursor"><label>Checkpoint cursor</label></input>
    <upload ref="/data/source_bundle"><label>Exact source bundle</label></upload>
  </h:body>
</h:html>
